application {
  config {
    baseName subscriptionservice
    applicationType microservice
    packageName com.toeic.subscription
    serverPort 8082
    authenticationType oauth2
    serviceDiscoveryType consul // Đổi thành eureka nếu bạn dùng JHipster Registry
    databaseType sql
    devDatabaseType mysql
    prodDatabaseType mysql
    cacheProvider redis
    buildTool maven
    clientFramework no
  }
  entities Plan, Subscription, PaymentTransaction
}

entity Plan {
  code String required unique maxlength(50)
  name String required maxlength(100)
  price BigDecimal required
  durationDays Integer required
  features String // JSON string lưu danh sách quyền
  isActive Boolean
}

entity Subscription {
  userId String required maxlength(36) // Lưu claim 'sub' (UUID) từ Keycloak
  status SubscriptionStatus required
  startsAt Instant required
  expiresAt Instant required
  createdAt Instant
}

entity PaymentTransaction {
  orderCode String required unique maxlength(50)
  gateway PaymentGateway required
  gatewayTransId String maxlength(100)
  amount BigDecimal required
  status PaymentStatus required
  createdAt Instant
}

enum SubscriptionStatus {
  TRIAL, ACTIVE, EXPIRED, CANCELLED
}

enum PaymentGateway {
  VNPAY, MOMO, STRIPE
}

enum PaymentStatus {
  PENDING, SUCCESS, FAILED
}

// Quan hệ nội bộ trong service
relationship ManyToOne {
  Subscription{plan(name)} to Plan
  PaymentTransaction{subscription} to Subscription
}

// Tùy chọn sinh mã nguồn chuẩn nghiệp vụ
dto * with mapstruct
service * with serviceImpl
paginate Plan, Subscription, PaymentTransaction with pagination