# ===================================================================
# TOEIC Pro Environment Variables Template
# Copy this file to .env and configure values before starting services
# ===================================================================

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_BUCKET_NAME=toeic-sever
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_cloudflare_r2_access_key_here
CLOUDFLARE_R2_SECRET_KEY=your_cloudflare_r2_secret_key_here
CLOUDFLARE_R2_PUBLIC_URL=https://<public_subdomain>.r2.dev

# Database Credentials
MYSQL_ROOT_PASSWORD=root_password_here

# Payment Gateway (if applicable)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
