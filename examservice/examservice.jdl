/**
 * ===================================================================
 * JDL Specification for EXAM SERVICE (examservice)
 * Toeic Pro Microservices Ecosystem
 * ===================================================================
 */

application {
  config {
    baseName examservice
    applicationType microservice
    packageName com.toeic.exam
    serverPort 8084
    authenticationType oauth2
    serviceDiscoveryType consul
    databaseType sql
    devDatabaseType mysql
    prodDatabaseType mysql
    cacheProvider redis
    buildTool maven
    clientFramework no
  }
  entities Exam, Part, QuestionGroup, Question, ExamAttempt, UserAnswer
}

/**
 * Danh mục đề thi (Full test 200 câu, Mini test, hoặc Practice)
 */
entity Exam {
  code String required unique maxlength(50)          // vd: ETS_2024_TEST_01
  title String required maxlength(255)               // vd: ETS TOEIC 2024 - Test 1
  category ExamCategory required                     // FULL_TEST, MINI_TEST, PRACTICE_PART
  durationMinutes Integer required                   // 120 phút
  totalQuestions Integer required                    // 200 câu
  audioFullUrl String maxlength(1000)                // URL CDN file mp3 full listening
  isPublished Boolean required                       // true = hiển thị cho học viên
  createdAt Instant required
}

/**
 * 7 Phần thi TOEIC (Part 1 -> Part 7)
 */
entity Part {
  partNumber Integer required min(1) max(7)          // 1 đến 7
  name String required maxlength(100)                // vd: Part 1: Photographs
  totalQuestions Integer required                    // Số câu của part (vd Part 1: 6)
}

/**
 * Nhóm câu hỏi (Dùng cho Part 3, 4, 6, 7 dùng chung bài đọc / audio hội thoại)
 */
entity QuestionGroup {
  passageText TextBlob                               // Đoạn văn bài đọc (Part 6, 7)
  audioUrl String maxlength(1000)                    // Audio đoạn hội thoại (Part 3, 4)
  imageUrl String maxlength(1000)                    // Ảnh bảng biểu, email, thông báo (Part 7)
}

/**
 * Chi tiết từng câu hỏi trắc nghiệm
 */
entity Question {
  questionNumber Integer required min(1) max(200)    // Số thứ tự câu (1 - 200)
  content TextBlob                                   // Nội dung câu hỏi (null nếu Part 1, 2)
  imageUrl String maxlength(1000)                    // Ảnh câu hỏi (Part 1)
  audioUrl String maxlength(1000)                    // Audio riêng từng câu (Part 1, 2)
  optionA TextBlob required                          // Lựa chọn A
  optionB TextBlob required                          // Lựa chọn B
  optionC TextBlob required                          // Lựa chọn C
  optionD TextBlob                                   // Lựa chọn D (Part 2 không có D)
  correctOption AnswerOption required                // Đáp án đúng: A, B, C, D
  explanation TextBlob                               // Lời giải chi tiết & dịch nghĩa
}

/**
 * Lịch sử lần làm bài thi của học viên
 */
entity ExamAttempt {
  userId String required maxlength(36)               // UUID học viên từ Keycloak (claim 'sub')
  status AttemptStatus required                      // IN_PROGRESS, COMPLETED, ABANDONED
  listeningScore Integer min(5) max(495)             // Điểm Listening (5 - 495)
  readingScore Integer min(5) max(495)               // Điểm Reading (5 - 495)
  totalScore Integer min(10) max(990)                // Tổng điểm TOEIC (10 - 990)
  correctAnswers Integer                             // Số câu đúng
  wrongAnswers Integer                               // Số câu sai
  skippedAnswers Integer                             // Số câu bỏ trống
  timeSpentSeconds Integer                           // Thời gian đã làm (giây)
  startedAt Instant required                         // Thời điểm bắt đầu
  completedAt Instant                                // Thời điểm nộp bài
}

/**
 * Chi tiết đáp án học viên chọn cho từng câu hỏi
 */
entity UserAnswer {
  selectedOption AnswerOption                        // A, B, C, D hoặc null nếu bỏ qua
  isCorrect Boolean                                  // true nếu chọn đúng
  timeSpentSeconds Integer                           // Thời gian suy nghĩ câu này (giây)
}

enum ExamCategory {
  FULL_TEST, MINI_TEST, PRACTICE_PART
}

enum AttemptStatus {
  IN_PROGRESS, COMPLETED, ABANDONED
}

enum AnswerOption {
  A, B, C, D
}

/**
 * Định nghĩa mối quan hệ giữa các thực thể
 */
relationship ManyToOne {
  Part{exam(title) required} to Exam
  QuestionGroup{part(name) required} to Part
  Question{part(name) required} to Part
  Question{questionGroup} to QuestionGroup
  ExamAttempt{exam(title) required} to Exam
  UserAnswer{examAttempt required} to ExamAttempt
  UserAnswer{question(questionNumber) required} to Question
}

/**
 * Cấu hình sinh mã nguồn chuẩn nghiệp vụ
 */
dto * with mapstruct
service * with serviceImpl
paginate Exam, ExamAttempt with pagination
paginate Question, UserAnswer with infinite-scroll
