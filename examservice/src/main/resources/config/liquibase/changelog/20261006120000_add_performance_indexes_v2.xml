        </createIndex>
        <createIndex indexName="idx_exam_attempt_history" tableName="exam_attempt">
            <column name="user_id"/>
            <column name="status"/>
            <column name="completed_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
